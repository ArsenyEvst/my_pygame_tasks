import pygame as pg
import random

FPS = 6
WIDTH, HEIGHT = 1600, 600
WHITE = (255, 255, 255)
SILVER = (164, 164, 164)
tickC = 0
tickO = 0
tickR = 0
tickJ = 0


class Dino(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Run.png').convert_alpha()
        self.image = pg.transform.scale(self.image, (90, 85))
        self.rect = self.image.get_rect(center=(100, 510))
        self.mask = pg.mask.from_surface(self.image)
        self.speed = 0
        self.g = 0
        self.flag_leg = 1

    def jump(self, dy=0):
        global tickJ
        if dy == -1:
            self.speed = 50
            self.g = 2
            tickJ = min(tickJ, 3)
        self.speed -= self.g * tickJ
        self.rect.y -= self.speed
            # if self.rect.y >= 550 or self.rect.y < 0:
            #     self.speed = 3
            #     self.rect.y = 510

    def run(self):
        global tickR
        if self.flag_leg == 1 and tickR == 10:
            self.image = pg.image.load(r'images/Chrome_T-Rex_Left_Run.png').convert_alpha()
            self.flag_leg = 0
            tickR = 0
        elif self.flag_leg == 0 and tickR == 10:
            self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Run.png').convert_alpha()
            self.flag_leg = 1
            tickR = 0

    def draw(self, screen):
        screen.blit(self.image, self.rect)


class Horizon(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.len_horizon = 2400
        self.flag_horizon = 1
        self.yC = random.randrange(100, 400)
        self.imageH1 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
        self.rectH1 = self.imageH1.get_rect(center=(WIDTH / 2, 550))
        self.imageH2 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
        self.rectH2 = self.imageH2.get_rect(center=(WIDTH / 2 + self.len_horizon, 550))
        self.maskH = pg.mask.from_surface(self.imageH1)
        self.imageC = pg.image.load(r'images/Chromium_T-Rex-cloud.png').convert_alpha()
        self.rectC = self.imageC.get_rect(center=(WIDTH / 2, self.yC))
        self.maskC = pg.mask.from_surface(self.imageC)
        self.speed = 10

    def update(self):
        self.rectH1.x -= self.speed
        self.rectH2.x -= self.speed
        if self.flag_horizon == 1:
            if self.rectH2.centerx <= WIDTH / 2:
                self.imageH1 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
                self.rectH1 = self.imageH1.get_rect(center=(WIDTH / 2 + self.len_horizon, 550))
                self.flag_horizon = 2
        elif self.flag_horizon == 2:
            if self.rectH1.centerx <= WIDTH / 2:
                self.imageH2 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
                self.rectH2 = self.imageH2.get_rect(center=(WIDTH / 2 + self.len_horizon, 550))
                self.flag_horizon = 1

    def draw(self, screen):
        screen.blit(self.imageH1, self.rectH1)
        screen.blit(self.imageH2, self.rectH2)


class Cloud(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.yC = random.randrange(100, 400)
        self.xC = 1700
        self.speedC = random.randrange(1, 5)
        self.image = pg.image.load(r'images/Chromium_T-Rex-cloud.png').convert_alpha()
        self.rect = self.image.get_rect(center=(self.xC, self.yC))
        self.maskC = pg.mask.from_surface(self.image)
        self.active = True

    def update(self, ):
        if self.rect.x <= -self.rect.width:
            self.kill()
        self.rect.x -= self.speedC

    def draw(self, screen):
        screen.blit(self.image, self.rect)


class Obstacle(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        obstacles_image = [r'images/1_Cactus_Chrome_Dino.png', r'images/3_Cactus_Chrome_Dino.png']
        obstacle_is = random.choice(obstacles_image)
        self.image = pg.image.load(obstacle_is)
        self.xC = 1650
        self.yC = 515
        self.rect = self.image.get_rect(center=(self.xC, self.yC))
        self.mask = pg.mask.from_surface(self.image)
        self.speedC = 10
        self.active = True

    def update(self):
        if self.rect.x <= -self.rect.width:
            self.kill()
        self.rect.x -= self.speedC

    def draw(self, screen):
        screen.blit(self.image, self.rect)


pg.init()
screen = pg.display.set_mode((WIDTH, HEIGHT))
screen.fill(WHITE)
pg.display.set_caption("Игра")
clock = pg.time.Clock()
# pg.mixer.music.load("sound/bgs.wav")
# acSound = pg.mixer.Sound("sound/accident.wav")
# pg.mixer.music.play(-1)

dino = Dino()
horizon = Horizon()
clouds = pg.sprite.Group()
clouds.add(Cloud())
obstacles = pg.sprite.Group()

background = pg.Surface((WIDTH, HEIGHT))
background.fill(WHITE)

screen.blit(background, (0, 0))
pg.display.update()

flag_play = True
while flag_play:
    clock.tick(FPS)
    tickC += 1
    tickO += 1
    tickR += 1
    tickJ += 1

    for event in pg.event.get():
        if event.type == pg.QUIT:
            pg.quit()
            flag_play = False
            break
    if not flag_play:
        break

    if tickC == 90:
        tickC = 0
        clouds.add(Cloud())

    if tickO >= random.randrange(120, 180, 15):
        tickO = 0
        obstacles.add(Obstacle())

    keys = pg.key.get_pressed()
    if (keys[pg.K_UP] or keys[pg.K_SPACE]) and tickJ >= 3:
        dino.jump(dy=-1)
    if keys[pg.K_DOWN]:
        dino.jump(dy=1)

    # if pg.sprite.spritecollideany(dino, obstacles, collided=pg.sprite.collide_mask):
    #     t = acSound.get_length()
    #     acSound.play()
    #     pg.time.wait(int(t) * 1000)
    #     break

    dino.run()
    dino.jump()
    clouds.update()
    horizon.update()
    obstacles.update()

    screen.blit(background, (0, 0))

    horizon.draw(screen)
    clouds.draw(screen)
    obstacles.draw(screen)
    dino.draw(screen)
    pg.display.update()
