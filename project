# Динозаврик Google
import pygame as pg
import random

FPS = 60
WIDTH, HEIGHT = 1600, 400
WHITE = (255, 255, 255)
BLACK = (95, 95, 95)
tickC = 0
tickO = 0
tickR = 0
tickJ = 0
tickF = 0
spawn = -1
time_play = 0
all_time_play = 0
scores = 0
game_over = False
STATE_NORMAL = "normal"
STATE_JUMP = "jump"
STATE_DUCK = "duck"
GAME_SPEED = 10
next_cactus_spawn = random.randint(90, 120)
next_bird_spawn = random.randint(90, 150)


class Dino(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Run.png').convert_alpha()
        self.rect = self.image.get_rect(bottom=350)
        self.rect.centerx = 100
        self.mask = pg.mask.from_surface(self.image)
        self.speed = 0
        self.g = 0
        self.flag_leg = True
        self.flag_state = STATE_NORMAL
        self.is_dead = False
        self.tickK = 0

    def jump(self, dy=0):
        if self.is_dead:
            return

        if dy == -1 and self.flag_state == STATE_NORMAL:
            self.flag_state = STATE_JUMP
            self.speed = 10
            self.g = 0.04
            self.tickK = 1
        self.speed -= self.g * self.tickK
        self.tickK += 1
        self.rect.y -= self.speed
        if self.flag_state == STATE_JUMP and self.rect.bottom > 350:
            self.rect.bottom = 350
            self.rect.centerx = 100
            self.speed = 0
            self.g = 0
            self.tickK = 0
            self.flag_state = STATE_NORMAL

    def run(self, dy=0):
        global tickR

        if self.is_dead:
            return

        flag_temp = -1
        if dy == 0 and self.flag_state != STATE_JUMP:
            self.flag_state = STATE_NORMAL
            flag_temp = 1
        if dy == 1 and self.flag_state != STATE_JUMP:
            flag_temp = 2
            self.flag_state = STATE_DUCK
        if self.flag_state != STATE_JUMP:
            if dy == 1:
                self.flag_state = STATE_DUCK
            else:
                self.flag_state = STATE_NORMAL

        if tickR >= 10 and self.flag_state != STATE_JUMP:
            if self.flag_state == STATE_NORMAL:
                if self.flag_leg:
                    self.flag_leg = False
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Left_Run.png').convert_alpha()
                else:
                    self.flag_leg = True
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Run.png').convert_alpha()
            else:
                if self.flag_leg:
                    self.flag_leg = False
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Left_Duck.png').convert_alpha()
                else:
                    self.flag_leg = True
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Duck.png').convert_alpha()
            self.mask = pg.mask.from_surface(self.image)
            tickR = 0

        if self.flag_state != STATE_JUMP:
            self.rect = self.image.get_rect(bottom=350)
            self.rect.centerx = 100

        # if flag_temp == 1:
        #     self.rect = self.image.get_rect(center=(100, 510))
        # elif flag_temp == 2:
        #     self.rect = self.image.get_rect(center=(100, 526))

    def death(self, dead=0):
        if dead == 1:
            self.is_dead = True
            self.image = pg.image.load(r'images/Dead_Chrome_T-Rex.png')
            self.rect.centerx = 100
            screen.blit(self.image, self.rect)
            if self.flag_state != STATE_JUMP:
                self.rect.bottom = 350

    def restart(self, keys):
        if self.is_dead:
            self.rest_image = pg.image.load(r'images/Chromium_T-Rex-restart.png')
            self.rest_rect = self.rest_image.get_rect(center=(WIDTH // 2, HEIGHT // 2))
            screen.blit(self.rest_image, self.rest_rect)
            text_rest.draw(screen)
            if keys[pg.K_SPACE] or keys[pg.K_UP]:
                return True
        return False

    def draw(self, screen):
        screen.blit(self.image, self.rect)


class Horizon(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.len_horizon = 2400
        self.flag_horizon = 1
        self.yC = random.randrange(100, 200)
        self.imageH1 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
        self.rectH1 = self.imageH1.get_rect(center=(WIDTH / 2, 350))
        self.imageH2 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
        self.rectH2 = self.imageH2.get_rect(center=(WIDTH / 2 + self.len_horizon, 350))
        self.maskH = pg.mask.from_surface(self.imageH1)
        self.imageC = pg.image.load(r'images/Chromium_T-Rex-cloud.png').convert_alpha()
        self.rectC = self.imageC.get_rect(center=(WIDTH / 2, self.yC))
        self.maskC = pg.mask.from_surface(self.imageC)
        self.speed = GAME_SPEED

    def update(self):
        global time_play

        self.rectH1.x -= self.speed
        self.rectH2.x -= self.speed
        if self.flag_horizon == 1:
            if self.rectH2.centerx <= WIDTH / 2:
                self.imageH1 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
                self.rectH1 = self.imageH1.get_rect(center=(WIDTH / 2 + self.len_horizon - 100, 350))
                self.flag_horizon = 2
        elif self.flag_horizon == 2:
            if self.rectH1.centerx <= WIDTH / 2:
                self.imageH2 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
                self.rectH2 = self.imageH2.get_rect(center=(WIDTH / 2 + self.len_horizon - 100, 350))
                self.flag_horizon = 1

    def draw(self, screen):
        screen.blit(self.imageH1, self.rectH1)
        screen.blit(self.imageH2, self.rectH2)


class Cloud(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.speedC = random.randrange(1, 5)
        self.image = pg.image.load(r'images/Chromium_T-Rex-cloud.png').convert_alpha()
        self.rect = self.image.get_rect(center=(1700, random.randrange(40, 200)))
        self.maskC = pg.mask.from_surface(self.image)
        self.active = True

    def update(self, ):
        if self.rect.x <= -self.rect.width:
            self.kill()
        self.rect.x -= self.speedC

    def draw(self, screen):
        screen.blit(self.image, self.rect)


class Obstacle(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        obstacles_image = [r'images/1_Cactus_Chrome_Dino.png', r'images/3_Cactus_Chrome_Dino.png']
        obstacle_is = random.choice(obstacles_image)
        self.image = pg.image.load(obstacle_is).convert_alpha()
        self.rect = self.image.get_rect(center=(1650, 315))
        self.mask = pg.mask.from_surface(self.image)
        self.speed = GAME_SPEED
        self.active = True

    def update(self):
        self.speed = GAME_SPEED
        if self.rect.x <= -self.rect.width:
            self.kill()
        self.rect.x -= self.speed

    def draw(self, screen):
        screen.blit(self.image, self.rect)


class Pterodactyl(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.image = pg.image.load(r'images/Chrome_Pterodactyl_Up.png').convert_alpha()  # 194*127//194*173
        self.image = pg.transform.scale(self.image, (100, 40))
        self.rect = self.image.get_rect(center=(1650, random.randrange(220, 290)))
        self.mask = pg.mask.from_surface(self.image)
        self.speed = GAME_SPEED
        self.flag_leg = True
        self.active = True

    def update(self):
        global tickF
        self.speed = GAME_SPEED

        if self.flag_leg and tickF >= 20:
            tickF = 0
            self.flag_leg = False
            self.image = pg.image.load(r'images/Chrome_Pterodactyl_Down.png').convert_alpha()
            self.image = pg.transform.scale(self.image, (100, 50))
            self.mask = pg.mask.from_surface(self.image)
        elif not self.flag_leg and tickF >= 20:
            tickF = 0
            self.flag_leg = True
            self.image = pg.image.load(r'images/Chrome_Pterodactyl_Up.png').convert_alpha()
            self.image = pg.transform.scale(self.image, (100, 40))
            self.mask = pg.mask.from_surface(self.image)

        if self.rect.x <= -self.rect.width:
            self.kill()
        self.rect.x -= self.speed

    def draw(self, screen):
        screen.blit(self.image, self.rect)


class Text_rest:
    def __init__(self, text, text_size, text_color, text_pos):
        self.font = pg.font.SysFont(None, text_size)
        self.suft = self.font.render(text, True, text_color)
        self.rect = self.suft.get_rect(center=text_pos)

    def draw(self, screen):
        screen.blit(self.suft, self.rect)


class Text_score:
    def __init__(self, text, text_size, text_color, text_pos):
        self.font = pg.font.SysFont(None, text_size)
        self.suft = self.font.render(text, True, text_color)
        self.rect = self.suft.get_rect(center=text_pos)

    def update(self):
        global scores

        if all_time_play <= 10 * 60:
            scores += 1
        elif 60 * 60 >= all_time_play > 10 * 60:
            scores += 5
        elif all_time_play <= 180 * 60 < all_time_play:
            scores += 10

    def draw(self, screen):
        screen.blit(self.suft, self.rect)


pg.init()
screen = pg.display.set_mode((WIDTH, HEIGHT))
screen.fill(WHITE)
pg.display.set_caption("Игра")
clock = pg.time.Clock()
# pg.mixer.music.load("sound/bgs.wav")
# acSound = pg.mixer.Sound("sound/accident.wav")
# pg.mixer.music.play(-1)

dino = Dino()
horizon = Horizon()
clouds = pg.sprite.Group()
clouds.add(Cloud())
obstacles = pg.sprite.Group()
pterodactyl = pg.sprite.Group()
text_rest = Text_rest("Чтобы начать игру заново, нажмите прыжок", 32, BLACK, (WIDTH / 2, HEIGHT * 1 / 3))
text_sc = Text_rest(r'scores', 32, BLACK, (1400, 50))

background = pg.Surface((WIDTH, HEIGHT))
background.fill(WHITE)

screen.blit(background, (0, 0))
pg.display.update()

flag_play = True
while flag_play:
    clock.tick(FPS)
    time_play += 1
    all_time_play += 1
    tickC += 1
    tickO += 1
    tickR += 1
    tickJ += 1
    tickF += 1
    spawn = random.randrange(0, 2)

    for event in pg.event.get():
        if event.type == pg.QUIT:
            pg.quit()
            flag_play = False
            break
    if not flag_play:
        break

    if time_play >= 60:
        if GAME_SPEED <= 25:
            GAME_SPEED += 0.1  # +1 = 10 sec
        horizon.speed = GAME_SPEED
        # print(GAME_SPEED)
        time_play = 0

    if tickC == 90:
        tickC = 0
        clouds.add(Cloud())

    if spawn == 0 and tickO >= next_cactus_spawn:
        tickO = 0
        obstacles.add(Obstacle())
    elif spawn == 1 and tickO >= next_bird_spawn:
        tickO = 0
        pterodactyl.add(Pterodactyl())

    keys = pg.key.get_pressed()
    if not game_over:
        if (keys[pg.K_UP] or keys[pg.K_SPACE]) and tickJ >= 45:
            tickJ = 0
            dino.jump(dy=-1)
        if keys[pg.K_DOWN]:
            dino.run(dy=1)
        else:
            dino.run(dy=0)

    if dino.restart(keys):
        game_over = False
        GAME_SPEED = 10
        next_cactus_spawn = random.randint(90, 120)
        next_bird_spawn = random.randint(90, 150)
        time_play = 0
        tickO = 0
        tickR = 0
        tickF = 0

        pg.time.wait(6 * 100)

        dino.is_dead = False
        dino.image = pg.image.load(r'images/Chrome_T-Rex_Right_Run.png')
        dino.rect.bottom = 530
        dino.rect.centerx = 100

        obstacles.empty()
        clouds.empty()
        pterodactyl.empty()

        continue

    if pg.sprite.spritecollideany(dino, obstacles, collided=pg.sprite.collide_mask):
        dino.death(dead=1)
        GAME_SPEED = 0
        horizon.speed = GAME_SPEED
        game_over = True

    if pg.sprite.spritecollideany(dino, pterodactyl, collided=pg.sprite.collide_mask):
        dino.death(dead=1)
        GAME_SPEED = 0
        horizon.speed = GAME_SPEED
        game_over = True

    dino.jump()
    clouds.update()
    horizon.update()
    obstacles.update()
    pterodactyl.update()

    screen.blit(background, (0, 0))

    horizon.draw(screen)
    clouds.draw(screen)
    obstacles.draw(screen)
    pterodactyl.draw(screen)
    dino.draw(screen)
    text_rest.draw(screen)
    text_sc.draw(screen)
    pg.display.update()
