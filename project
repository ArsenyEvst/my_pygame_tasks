# Динозаврик Google
import pygame as pg
import random

FPS = 60
WIDTH, HEIGHT = 1600, 400
WHITE = (255, 255, 255)
tickC = 0
tickO = 0
tickR = 0
tickJ = 0
tickF = 0
spawn = -1
time_play = 0
STATE_NORMAL = "normal"
STATE_JUMP = "jump"
STATE_DUCK = "duck"


class Dino(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Run.png').convert_alpha()
        self.rect = self.image.get_rect(bottom=350)
        self.rect.centerx = 100
        self.mask = pg.mask.from_surface(self.image)
        self.speed = 0
        self.g = 0
        self.flag_leg = True
        self.flag_state = STATE_NORMAL
        self.tickK = 0

    def jump(self, dy=0):
        if dy == -1 and self.flag_state != STATE_DUCK:
            self.flag_state = STATE_JUMP
            self.speed = 10
            self.g = 0.04
            self.tickK = 1
        self.speed -= self.g * self.tickK
        self.tickK += 1
        self.rect.y -= self.speed
        if self.flag_state == STATE_JUMP and self.rect.bottom > 350:
            self.rect.bottom = 350
            self.rect.centerx = 100
            self.speed = 0
            self.g = 0
            self.tickK = 0
            self.flag_state = STATE_NORMAL

    def run(self, dy=0):
        global tickR

        flag_temp = -1
        if dy == 0 and self.flag_state != STATE_JUMP:
            self.flag_state = STATE_NORMAL
            flag_temp = 1
        if dy == 1 and self.flag_state != STATE_JUMP:
            flag_temp = 2
            self.flag_state = STATE_DUCK
        if self.flag_state != STATE_JUMP:
            if dy == 1:
                self.flag_state = STATE_DUCK
            else:
                self.flag_state = STATE_NORMAL

        if tickR >= 10 and self.flag_state != STATE_JUMP:
            if self.flag_state == STATE_NORMAL:
                if self.flag_leg:
                    self.flag_leg = False
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Left_Run.png').convert_alpha()
                else:
                    self.flag_leg = True
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Run.png').convert_alpha()
            else:
                if self.flag_leg:
                    self.flag_leg = False
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Left_Duck.png').convert_alpha()
                else:
                    self.flag_leg = True
                    self.image = pg.image.load(r'images/Chrome_T-Rex_Right_Duck.png').convert_alpha()
            self.mask = pg.mask.from_surface(self.image)
            tickR = 0

        if self.flag_state != STATE_JUMP:
            self.rect = self.image.get_rect(bottom=350)
            self.rect.centerx = 100

        # if flag_temp == 1:
        #     self.rect = self.image.get_rect(center=(100, 510))
        # elif flag_temp == 2:
        #     self.rect = self.image.get_rect(center=(100, 526))

    def death(self, dead=0):
        if dead == 1:
            self.image = pg.image.load(r'images/Dead_Chrome_T-Rex.png')
            self.rect.centerx = 100
            screen.blit(self.image, self.rect)

    def draw(self, screen):
        screen.blit(self.image, self.rect)


class Horizon(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.len_horizon = 2400
        self.flag_horizon = 1
        self.yC = random.randrange(100, 200)
        self.imageH1 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
        self.rectH1 = self.imageH1.get_rect(center=(WIDTH / 2, 350))
        self.imageH2 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
        self.rectH2 = self.imageH2.get_rect(center=(WIDTH / 2 + self.len_horizon, 350))
        self.maskH = pg.mask.from_surface(self.imageH1)
        self.imageC = pg.image.load(r'images/Chromium_T-Rex-cloud.png').convert_alpha()
        self.rectC = self.imageC.get_rect(center=(WIDTH / 2, self.yC))
        self.maskC = pg.mask.from_surface(self.imageC)
        self.speed = 10

    def update(self):
        global time_play

        self.rectH1.x -= self.speed
        self.rectH2.x -= self.speed
        if self.flag_horizon == 1:
            if self.rectH2.centerx <= WIDTH / 2:
                self.imageH1 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
                self.rectH1 = self.imageH1.get_rect(center=(WIDTH / 2 + self.len_horizon - 100, 350))
                self.flag_horizon = 2
        elif self.flag_horizon == 2:
            if self.rectH1.centerx <= WIDTH / 2:
                self.imageH2 = pg.image.load(r'images/Chromium_T-Rex-horizon.png').convert_alpha()
                self.rectH2 = self.imageH2.get_rect(center=(WIDTH / 2 + self.len_horizon - 100, 350))
                self.flag_horizon = 1

    def timer(self):
        self.speed += 1

    def draw(self, screen):
        screen.blit(self.imageH1, self.rectH1)
        screen.blit(self.imageH2, self.rectH2)


