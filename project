class Pterodactyl(pg.sprite.Sprite):
    def __init__(self):
        pg.sprite.Sprite.__init__(self)
        self.image = pg.image.load(r'images/Chrome_Pterodactyl_Up.png').convert_alpha()  # 194*127//194*173
        self.image = pg.transform.scale(self.image, (100, 40))
        self.rect = self.image.get_rect(center=(1650, random.randrange(220, 290)))
        self.mask = pg.mask.from_surface(self.image)
        self.speed = 10
        self.flag_leg = True
        self.active = True

    def update(self):
        global tickF

        if self.flag_leg and tickF >= 20:
            tickF = 0
            self.flag_leg = False
            self.image = pg.image.load(r'images/Chrome_Pterodactyl_Down.png').convert_alpha()
            self.image = pg.transform.scale(self.image, (100, 50))
            self.mask = pg.mask.from_surface(self.image)
        elif not self.flag_leg and tickF >= 20:
            tickF = 0
            self.flag_leg = True
            self.image = pg.image.load(r'images/Chrome_Pterodactyl_Up.png').convert_alpha()
            self.image = pg.transform.scale(self.image, (100, 40))
            self.mask = pg.mask.from_surface(self.image)

        if self.rect.x <= -self.rect.width:
            self.kill()
        self.rect.x -= self.speed

    def timer(self):
        self.speed += 1

    def draw(self, screen):
        screen.blit(self.image, self.rect)


pg.init()
screen = pg.display.set_mode((WIDTH, HEIGHT))
screen.fill(WHITE)
pg.display.set_caption("Игра")
clock = pg.time.Clock()
# pg.mixer.music.load("sound/bgs.wav")
# acSound = pg.mixer.Sound("sound/accident.wav")
# pg.mixer.music.play(-1)

dino = Dino()
horizon = Horizon()
clouds = pg.sprite.Group()
clouds.add(Cloud())
obstacles = pg.sprite.Group()
pterodactyl = pg.sprite.Group()

background = pg.Surface((WIDTH, HEIGHT))
background.fill(WHITE)

screen.blit(background, (0, 0))
pg.display.update()

flag_play = True
while flag_play:
    clock.tick(FPS)
    time_play += 1
    tickC += 1
    tickO += 1
    tickR += 1
    tickJ += 1
    tickF += 1
    spawn = random.randrange(0, 2)

    for event in pg.event.get():
        if event.type == pg.QUIT:
            pg.quit()
            flag_play = False
            break
    if not flag_play:
        break

    if time_play >= 60 * 5:
        horizon.timer()
        for elem in obstacles:
            elem.timer()
        for elem in pterodactyl:
            elem.timer()
        time_play = 0

    if tickC == 90:
        tickC = 0
        clouds.add(Cloud())

    if spawn == 0 and tickO >= random.randint(90, 120):
        tickO = 0
        obstacles.add(Obstacle())
    elif spawn == 1 and tickO >= random.randint(90, 120):
        tickO = 0
        pterodactyl.add(Pterodactyl())

    keys = pg.key.get_pressed()
    if (keys[pg.K_UP] or keys[pg.K_SPACE]) and tickJ >= 45:
        tickJ = 0
        dino.jump(dy=-1)

    if keys[pg.K_DOWN]:
        dino.run(dy=1)
    else:
        dino.run(dy=0)

    if pg.sprite.spritecollideany(dino, obstacles, collided=pg.sprite.collide_mask):
        dino.death(dead=1)
        screen.blit(background, (0, 0))
        horizon.draw(screen)
        clouds.draw(screen)
        obstacles.draw(screen)
        pterodactyl.draw(screen)
        dino.draw(screen)
        pg.display.update()
        # pg.time.wait(60 * 100)
        break

    if pg.sprite.spritecollideany(dino, pterodactyl, collided=pg.sprite.collide_mask):
        dino.death(dead=1)
        screen.blit(background, (0, 0))
        horizon.draw(screen)
        clouds.draw(screen)
        obstacles.draw(screen)
        pterodactyl.draw(screen)
        dino.draw(screen)
        pg.display.update()
        # pg.time.wait(60 * 100)
        break

    dino.jump()
    clouds.update()
    horizon.update()
    obstacles.update()
    pterodactyl.update()

    screen.blit(background, (0, 0))

    horizon.draw(screen)
    clouds.draw(screen)
    obstacles.draw(screen)
    pterodactyl.draw(screen)
    dino.draw(screen)
    pg.display.update()
